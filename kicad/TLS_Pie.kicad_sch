  (text "R_PU is the gating item -- nothing turns until it is fitted.\nEvery Pi GPIO floats as an input for the ~30 s the Pi takes to boot,\nand ENABLE is active-low. Without this the driver can sit energised\nthrough the whole of boot with nothing in control of it.\nIt goes on the DRIVER side of R_EN, and pulls up to the driver's own\nVCC -- not the Pi's 3V3 -- so it still holds with the Pi unplugged.\nSet the APWR jumper to 3.3 V and MEASURE VCC before wiring to it." (exclude_from_sim yes) (at 25.4 309.91 0) (effects (font (size 1.5 1.5)) (justify left)) (uuid "32c60754-e134-55e0-9a4f-9650ec5243cd"))
  (wire (pts (xy 48.26 269.24) (xy 33.02 269.24)) (stroke (width 0) (type default)) (uuid "1547eea5-e3b3-5c72-b373-bbad3467b9b0"))
  (label "GND" (at 33.02 269.24 0) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "33774386-cead-5e36-bb86-2bafba575199"))
  (wire (pts (xy 200.66 219.71) (xy 185.42 219.71)) (stroke (width 0) (type default)) (uuid "fe52d805-98de-50d4-8a00-81d49c0f04ac"))
  (label "GND" (at 185.42 219.71 0) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "986a2eb7-1ec9-51dc-a165-83c712ce2c63"))
