# TLS Pie local touch panel -- systemd unit
#
# Puts the SAME control panel the phone uses onto the rig's own 5.5" Waveshare
# HDMI AMOLED. Not a second interface -- literally the same web app, rendered
# by a browser running on the Pi and pointed at localhost:8080.
#
# WHY THAT MATTERS
# A native local UI would be a second codebase to keep in step with the phone
# panel, and the two would drift the first time either changed. Rendering the
# existing panel means there is exactly one UI, one set of controls, and one
# place a bug can live. The phone keeps working unchanged, and both surfaces
# show the same scanner state because they poll the same process.
#
# INSTALL
#   Do not install this by hand -- run ./setup_kiosk.sh, which installs the
#   packages, puts the user in the right groups, works out the display mode and
#   then enables this unit. Installing the unit alone gives a black screen.
#
# WATCH IT
#   journalctl -u tls-kiosk -f
#
# ⚠ THIS UNIT DOES NOT MOVE THE MOTOR. It starts a browser. Everything it can
# do, it does by talking to tls-scan.service over HTTP, exactly as the phone
# does. Stopping it takes the local screen away and leaves the scanner running.

[Unit]
Description=TLS Pie local touch panel (kiosk browser)
Documentation=file:/home/lipi/TLS-Pie/PROJECT_CONTEXT.md

# The panel is served by tls-scan. Wants= not Requires=: if the scanner is down
# we still want the screen up, showing a connection error, rather than a black
# panel that tells the operator nothing. A blank screen and a broken scanner
# look identical from two feet away, and that is the situation this avoids.
After=tls-scan.service systemd-user-sessions.service
Wants=tls-scan.service

# No display attached means no kiosk. Without this the unit restart-loops
# forever on a headless boot, which is the normal state when the rig is being
# driven from the phone alone.
ConditionPathExists=/dev/dri/card1

StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=lipi
WorkingDirectory=/home/lipi/TLS-Pie

# cage is a wlroots kiosk compositor: one fullscreen client, no desktop, no
# window manager, nothing to accidentally swipe away. It needs access to the
# seat -- the GPU and the input devices -- which comes from seatd plus
# membership of video/render/input. setup_kiosk.sh arranges both.
#
# ⛔ DO NOT ADD PAMName=login + TTYPath=/dev/tty1 HERE.
# That is the pattern most kiosk guides use, and it FAILED ON THIS RIG
# (2026-08-10): getty@tty1 is active, so StandardInput=tty-fail could not claim
# the TTY and the unit exited 1 five seconds after every start, with no message
# explaining why -- just "Deactivated successfully" on a loop. Running cage as
# lipi with seatd works without a TTY at all, so the whole mechanism was
# unnecessary. Avoiding it also leaves the console login on tty1 intact, which
# is the only way into this machine if the network is down.
#
# XDG_RUNTIME_DIR must exist for cage to start, and without a login session
# nothing creates it. `loginctl enable-linger lipi` makes systemd create
# /run/user/1000 at boot; setup_kiosk.sh enables it.
StandardOutput=journal
StandardError=journal

Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=wayland
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1

# Kill the mouse pointer. There is no mouse on this rig, so it is an arrow
# parked in the middle of the screen forever.
#
# Why it appears at all: with no pointer device ever moving, chromium never
# gets a pointer-enter event and never sets a cursor, so the COMPOSITOR keeps
# drawing its default one where it started. CSS cursor:none in the page cannot
# reach it, and XCURSOR_SIZE=1 alone did not work either.
#
# cage has no hide-cursor option -- its whole option list is -d -h -m -s -v --
# so the lever is a cursor theme whose images are a single transparent pixel.
# setup_kiosk.sh generates it at ~/.icons/tlspie-blank.
Environment=XCURSOR_SIZE=1
Environment=XCURSOR_THEME=tlspie-blank
Environment=XCURSOR_PATH=/home/lipi/.icons

# --- the two knobs worth tuning ---------------------------------------------
#
# TLSPIE_KIOSK_URL
#   If TLSPIE_WEB_TOKEN is set on tls-scan.service, the panel requires a token
#   and this URL must carry it:  http://localhost:8080/?t=<token>
#
# TLSPIE_KIOSK_ZOOM
#   Page zoom as a percentage. The panel is 1080x1920 across 5.5 inches --
#   about 400 PPI -- so rendered 1:1 every control is roughly a third the size
#   of the same control on a phone. 250 gives a ~432 CSS-pixel viewport, close
#   to a phone's. Raise for bigger targets, lower to fit more on screen.
#
#   ⛔ This is a CSS zoom, NOT --force-device-scale-factor. That flag was tried
#   on 2026-08-10 and shrank chromium's Wayland surface to exactly one third:
#   a 360x640 plane in the top-left of a 1080x1920 screen, rest black.
Environment=TLSPIE_KIOSK_URL=http://localhost:8080/
Environment=TLSPIE_KIOSK_ZOOM=250

ExecStart=/usr/bin/cage -- /home/lipi/TLS-Pie/tls_kiosk_launch.sh

# The screen is the rig's face. If the browser dies the operator is left with
# nothing to look at, so bring it straight back. The burst limit in [Unit]
# stops that becoming a tight loop.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
