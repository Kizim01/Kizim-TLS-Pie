# TLS Pie scanner -- systemd unit
#
# Runs the scanner independently of any login session, so a dropped SSH or WiFi
# link cannot kill it. That matters more than convenience: pigpio clocks step
# pulses from the DMA engine, so a controller killed mid-scan leaves the motor
# turning with nothing in control of it. Running under systemd means the only
# routine way the process ends is SIGTERM, which the controller handles.
#
# INSTALL
#   sudo cp tls-scan.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now tls-scan
#
# WATCH IT (from a laptop or phone over SSH)
#   journalctl -u tls-scan -f
#
# The phone control panel is at http://<pi>:8080/ once this is running.
#
# ENABLED 2026-08-09 so the panel comes up on its own at every boot, with no
# SSH and nothing to remember. Starting this unit does NOT move the motor: the
# controller comes up IDLE and only turns the head when someone presses a scan
# on the panel.
#
# ⚠ TWO THINGS THAT ARE NOW ALWAYS TRUE
#
# 1. The panel is reachable to anyone on the same network from the moment the
#    Pi boots, and it has no token, so anyone on it can start the motor. That
#    is fine on a private phone hotspot and NOT fine on a site network -- set
#    TLSPIE_WEB_TOKEN below before this ever joins one.
# 2. The 10k ENABLE pull-up IS fitted -- verified 2026-08-09, 40/40 reads HIGH
#    under both internal pulls. Every Pi GPIO floats for the ~30 s of boot and
#    ENABLE is active-low, so without that resistor the driver would sit
#    energised with nothing in control of it. This header claimed the resistor
#    was missing for a day after it had been fitted; if a warning here ever
#    disagrees with the hardware, trust the hardware and fix the comment.

[Unit]
Description=TLS Pie lidar scanner controller
Documentation=file:/home/lipi/TLS-Pie/MICROVIEW_REMOVAL.md

# Deliberately NOT network-online.target. The panel binds 0.0.0.0, so it does
# not need an address in order to start -- it becomes reachable the moment the
# network turns up. Waiting for network-online would stall boot for the best
# part of two minutes every time the Pi is switched on before the phone's
# hotspot, which is the normal order of events on site.
After=network.target pigpiod.service
Requires=pigpiod.service

# These belong in [Unit]. They were in [Service], where systemd IGNORES them,
# so the guard against restarting in a tight loop while the motor is energised
# was never actually in effect.
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/lipi/TLS-Pie
ExecStart=/usr/bin/python3 /home/lipi/TLS-Pie/tls_scan.py

# tcpdump needs raw sockets. Prefer setcap on tcpdump and drop this to a normal
# user; running the motor controller as root is not required by anything else.
#   sudo setcap cap_net_raw,cap_net_admin=eip /usr/bin/tcpdump
User=root

Environment=ETH_INTERFACE=eth0
Environment=LIDAR_IP=192.168.1.201
Environment=DUMPDIR=/home/lipi/velodyne
# Uncomment to require a token on the control panel. Without one, anyone who
# can reach the Pi on the network can start the motor.
#Environment=TLSPIE_WEB_TOKEN=change-me

# A scan takes up to ~6.5 minutes. Give the controller time to decelerate the
# motor, close the pcap and park the head before systemd escalates to SIGKILL
# -- a SIGKILL here is exactly the case that orphans the DMA waveform.
KillSignal=SIGTERM
TimeoutStopSec=600
SendSIGKILL=yes

# Restart if it dies, but never in a tight loop: repeated restarts while the
# motor is energised are worse than staying down. The burst limit that backs
# this up is in [Unit] above, which is the only place systemd reads it.
Restart=on-failure
RestartSec=15

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
