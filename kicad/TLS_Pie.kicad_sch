      (effects (font (size 1.27 1.27)))
    )
    (property "Description" "Cricklewood BMS4S, 60x45 mm. Pads verified 2026-08-11: five tap pads named by voltage, plus TWO output pads marked (-) and (+) -- P- and P+ on this sheet. COMMON PORT, no C- pad, so charge and discharge share them. 4.2 V/cell over-volt, 2.5 V/cell under-volt, 20 A charge, 40 A discharge. FETs are in the NEGATIVE leg, so the (+) pad is the same copper as the 16.8V pad -- only the return is switched"
      (at 116.84 78.74 0)
      (hide yes)
      (effects (font (size 1.27 1.27)))
    )
